<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/browseFragment">

    <fragment
        android:id="@+id/gamesFragment"
        android:name="com.xick.app.ui.games.GamesFragment"
        android:label="@string/nav_games">
        <action
            android:id="@+id/action_games_to_category"
            app:destination="@id/categoryFragment" />
    </fragment>

    <!-- Popüler: global stream feed. -->
    <fragment
        android:id="@+id/browseFragment"
        android:name="com.xick.app.ui.browse.BrowseFragment"
        android:label="@string/nav_popular">
        <action
            android:id="@+id/action_browse_to_channel"
            app:destination="@id/channelFragment" />
        <action
            android:id="@+id/action_browse_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.xick.app.ui.search.SearchFragment"
        android:label="@string/search_hint">
        <action
            android:id="@+id/action_search_to_channel"
            app:destination="@id/channelFragment" />
        <action
            android:id="@+id/action_search_to_category"
            app:destination="@id/categoryFragment" />
    </fragment>

    <!-- One category's streams (opened from Oyunlar); same fragment as Popüler, with a categoryId arg. -->
    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.xick.app.ui.browse.BrowseFragment"
        android:label="@string/nav_games">
        <argument android:name="categoryId" app:argType="integer" />
        <action
            android:id="@+id/action_category_to_channel"
            app:destination="@id/channelFragment" />
    </fragment>

    <fragment
        android:id="@+id/channelFragment"
        android:name="com.xick.app.ui.channel.ChannelFragment"
        android:label="@string/channel">
        <argument android:name="channelSlug" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/channelProfileFragment"
        android:name="com.xick.app.ui.channel.ChannelProfileFragment"
        android:label="@string/channel">
        <argument android:name="slug" app:argType="string" />
        <action
            android:id="@+id/action_channelProfile_to_vod"
            app:destination="@id/vodPlayerFragment" />
        <action
            android:id="@+id/action_channelProfile_to_channel"
            app:destination="@id/channelFragment" />
    </fragment>

    <fragment
        android:id="@+id/vodPlayerFragment"
        android:name="com.xick.app.ui.vod.VodPlayerFragment"
        android:label="@string/vod" />

    <!-- Global actions so any screen (browse cards, search) can open a profile/login. -->
    <action
        android:id="@+id/action_global_channelProfile"
        app:destination="@id/channelProfileFragment" />
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment" />

    <fragment
        android:id="@+id/followingFragment"
        android:name="com.xick.app.ui.following.FollowingFragment"
        android:label="@string/nav_following">
        <action
            android:id="@+id/action_following_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/savedFragment"
        android:name="com.xick.app.ui.profile.ProfileFragment"
        android:label="@string/nav_saved" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.xick.app.ui.login.LoginFragment"
        android:label="@string/sign_in" />

</navigation>
